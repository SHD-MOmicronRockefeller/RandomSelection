{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Qt Debug (MinGW GDB)",
            "type": "cppdbg",
            "request": "launch",
            // 核心：精准指向 Debug 产物路径
            "program": "${workspaceFolder}/build_debug/debug/Application_Debug.exe",
            "args": [],
            "stopAtEntry": false, // 想在 main 函数断点启动，可改为 true
            "cwd": "${workspaceFolder}",
            // 关键：添加 Qt 运行环境，避免找不到动态库
            "environment": [
                {
                    "name": "PATH",
                    "value": "D:\\DownApp\\QtManager\\6.10.2\\mingw_64\\bin;${env:PATH}" // 适配你的 Qt 6.10.1 路径
                }
            ],
            "externalConsole": true, // 保留独立控制台，方便查看输出
            // 关联 Debug 编译任务，调试前自动编译最新代码
            // "preLaunchTask": "QMake: Build (Debug)",
            "MIMode": "gdb",
            // 适配你的 MinGW GDB 路径
            "miDebuggerPath": "D:\\DownApp\\QtManager\\Tools\\mingw1310_64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "启用 GDB 美化打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "反汇编风格改为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "symbolLoadInfo": {
                "loadAll": true, // 加载所有调试符号，断点更精准
                "exceptionList": ""
            },
            // 源码映射：解决 GDB 无法定位本地源码的问题
            "sourceFileMap": {
                "/build_debug": "${workspaceFolder}/build_debug",
                "/build_release": "${workspaceFolder}/build_release"
            }
        }
    ]
}